<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false">
    <shape android:shape="rectangle">
      <solid android:color="#3A2431" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <gradient android:angle="0" android:startColor="#FF5F78" android:endColor="#E84B8A" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient android:angle="0" android:startColor="#FF6B81" android:endColor="#EF4D8E" />
      <corners android:radius="18dp" />
    </shape>
  </item>
</selector>