<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="@color/bg"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="12dp"
  android:paddingBottom="24dp"
  android:scrollbars="none">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="6dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡"
        android:textSize="30sp"
        android:layout_gravity="center_vertical" />
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="极速连点"
          android:textSize="24sp"
          android:textStyle="bold"
          android:textColor="@color/text" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="多位置顺序点击 · 长按 · 滑动 · 多点同时"
          android:textSize="12sp"
          android:textColor="@color/muted"
          android:layout_marginTop="2dp" />
      </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="12dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="悬浮控制球"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="在其他应用里显示悬浮球：点开上滑开始、下滑停止，左侧可退出应用。"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <Switch
          android:id="@+id/quickSwitch"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:showText="true"
          android:textOff="关"
          android:textOn="开"
          android:thumbTint="@color/accent"
          android:trackTint="#33FFFFFF" />
      </LinearLayout>
    </LinearLayout>
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v4.2"
        android:textSize="11sp"
        android:textColor="@color/accent"
        android:background="@drawable/bg_badge"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_gravity="center_vertical" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="12dp">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="14dp"
        android:layout_marginEnd="6dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="无障碍"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvA11y"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="未开启"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="@color/warm"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="14dp"
        android:layout_marginStart="6dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="运行状态"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvRun"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="待机"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="@color/accent"
          android:layout_marginTop="4dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="8dp">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="14dp"
        android:layout_marginEnd="6dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="已点击"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvClicks"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="@color/text"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="14dp"
        android:layout_marginStart="6dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="已用时间"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvElapsed"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="00:00"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="@color/info"
          android:layout_marginTop="4dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="8dp">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="12dp"
        android:layout_marginEnd="4dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="今日点击"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvToday"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/accent"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="12dp"
        android:layout_marginStart="4dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="累计点击"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/info"
          android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_stat"
        android:padding="12dp"
        android:layout_marginStart="4dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="点击速率"
          android:textSize="11sp"
          android:textColor="@color/muted" />
        <TextView
          android:id="@+id/tvRate"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0 次/秒"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/warm"
          android:layout_marginTop="4dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="12dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="无障碍服务"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text" />
      <TextView
        android:id="@+id/a11yHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启后可在其他应用界面模拟真实点击。"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp" />
      <Button
        android:id="@+id/enableBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="前往开启无障碍"
        android:textColor="#08140F"
        android:textStyle="bold"
        android:textSize="15sp"
        android:background="@drawable/bg_primary"
        android:layout_marginTop="14dp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="12dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="点击位置"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/text" />
        <TextView
          android:id="@+id/posCount"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0 个"
          android:textSize="12sp"
          android:textColor="@color/accent"
          android:background="@drawable/bg_badge"
          android:paddingStart="10dp"
          android:paddingEnd="10dp"
          android:paddingTop="4dp"
          android:paddingBottom="4dp" />
      </LinearLayout>
      <TextView
        android:id="@+id/posInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="还没设置位置，点击下方按钮打开悬浮标定位。"
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp" />
      <LinearLayout
        android:id="@+id/posList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
          android:id="@+id/setPos"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:text="设置圆点"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="#241503"
          android:background="@drawable/bg_warn"
          android:layout_marginEnd="6dp" />
        <Button
          android:id="@+id/templateBtn"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:text="快捷模板"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/text"
          android:background="@drawable/bg_neutral"
          android:layout_marginStart="6dp" />
      </LinearLayout>
      <Button
        android:id="@+id/clearPos"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="清空全部位置"
        android:textSize="14sp"
        android:textColor="@color/text"
        android:background="@drawable/bg_neutral"
        android:layout_marginTop="10dp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <Button
          android:id="@+id/saveProfileBtn"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:text="保存方案"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="#08140F"
          android:background="@drawable/bg_primary"
          android:layout_marginEnd="6dp" />
        <Button
          android:id="@+id/profileBtn"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:text="方案库"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/text"
          android:background="@drawable/bg_neutral"
          android:layout_marginStart="6dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <Button
          android:id="@+id/galleryBtn"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:text="模板图鉴"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/accent"
          android:background="@drawable/bg_input"
          android:layout_marginEnd="6dp" />
        <Button
          android:id="@+id/helpBtn"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:text="图文教程"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="#241503"
          android:background="@drawable/bg_warn"
          android:layout_marginStart="6dp" />
      </LinearLayout>
    </LinearLayout>    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="12dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击参数"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <EditText
          android:id="@+id/interval"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:inputType="number"
          android:hint="间隔 ms"
          android:text="150"
          android:textColor="@color/text"
          android:textColorHint="@color/muted"
          android:background="@drawable/bg_input"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:layout_marginEnd="6dp" />
        <EditText
          android:id="@+id/jitter"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:inputType="number"
          android:hint="随机抖动 ms"
          android:text="0"
          android:textColor="@color/text"
          android:textColorHint="@color/muted"
          android:background="@drawable/bg_input"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:layout_marginStart="6dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <EditText
          android:id="@+id/total"
          android:layout_width="0dp"
          android:layout_height="52dp"
          android:layout_weight="1"
          android:inputType="number"
          android:hint="点击次数（0=无限）"
          android:text="50"
          android:textColor="@color/text"
          android:textColorHint="@color/muted"
          android:background="@drawable/bg_input"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:layout_marginEnd="6dp" />
        <CheckBox
          android:id="@+id/infinite"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="无限循环"
          android:textSize="13sp"
          android:textColor="@color/text"
          android:buttonTint="@color/accent"
          android:layout_marginStart="8dp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:layout_marginEnd="6dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模式"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="4dp" />
          <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/modes"
            android:background="@drawable/bg_input" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:layout_marginStart="6dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="手势"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="4dp" />
          <Spinner
            android:id="@+id/gestureSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/gestures"
            android:background="@drawable/bg_input" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="12dp">
      <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="就绪"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/accent" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
          android:id="@+id/startBtn"
          android:layout_width="0dp"
          android:layout_height="54dp"
          android:layout_weight="1"
          android:text="开始连点"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="#08140F"
          android:background="@drawable/bg_primary"
          android:layout_marginEnd="6dp" />
        <Button
          android:id="@+id/stopBtn"
          android:layout_width="0dp"
          android:layout_height="54dp"
          android:layout_weight="1"
          android:text="停止"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:background="@drawable/bg_danger"
          android:layout_marginStart="6dp" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_card"
      android:padding="18dp"
      android:layout_marginTop="12dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="运行记录"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text" />
      <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:text="等待开始"
        android:textSize="12sp"
        android:textColor="#B8C6DA"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:layout_marginTop="10dp" />
    </LinearLayout>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="支持方案保存、统计与多点同时，重启后依然生效。"
      android:textSize="12sp"
      android:textColor="@color/muted"
      android:gravity="center"
      android:layout_marginTop="14dp" />
  </LinearLayout>
</ScrollView>